# Notion integration — used for waitlist and contact form submissions
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database used as the CMS for the /blog section (same integration/token as above)
NOTION_BLOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailtrap — transactional email delivery (confirmation email to the submitter)
MAILTRAP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — internal notification email to hello@protegey.com on new waitlist submissions
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Analytics — set to "true" to enable in production
VERCEL_ANALYTICS_ENABLED=true
